    subgraph Open ["Open Gaps & NOT DONE YET (To Reach v0.3)"]
      direction TB
      G_UNREAD["UNREAD SOURCES (NOT DONE)<br/>988 Nov-12 DOIs (244 full text)<br/>336 Kosmos rows (321 abstract-only)<br/>22 entries still have 0 papers"]:::notdone
      G_BIND["MISSING GATE (NOT DONE)<br/>Controlled schema + sample binding check<br/>Deduplicate twin entries (CheA 114 rows)<br/>Synthesize remaining 78+ valued entries"]:::notdone
      G_GINA["NMR EXPERT REVIEW (NOT DONE)<br/>Gina checks 4 worked cards & decides:<br/>MD/non-NMR cutoff & comparability rules"]:::notdone
      G_BMRB["NEXT RELEASE & BMRB CHECK (NOT DONE)<br/>Screen + double-extract unread 244 DOIs<br/>Cross-check rates vs BMRB raw data"]:::notdone
    end

    S1 -.->|"Gap"| G_UNREAD
    S5 -.->|"Gap"| G_BIND
    S6 -->|"Ready for review"| G_GINA
    G_UNREAD -.-> G_BMRB
    G_BIND -.-> G_BMRB
    G_GINA -->|"Unlocks v0.3"| G_BMRB

    subgraph Legend ["Legend (Decider)"]
      direction TB
      L1["Blue: Program (fixed rule)"]:::program
      L2["Purple: Reader LLM (judgment)"]:::reader
      L3["Green: Second-family LLM (sample)"]:::second
      L4["Amber: Human Curator"]:::person
      L5["Dashed Red: NOT DONE YET"]:::notdone
