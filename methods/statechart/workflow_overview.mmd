flowchart LR
    classDef program fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a,stroke-width:2px
    classDef reader fill:#ede9fe,stroke:#6d28d9,color:#4c1d95,stroke-width:2px
    classDef second fill:#d1fae5,stroke:#047857,color:#064e3b,stroke-width:2px
    classDef person fill:#fef3c7,stroke:#b45309,color:#78350f,stroke-width:2px
    classDef notdone fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d,stroke-width:2px,stroke-dasharray: 5 5
    classDef blocked fill:#e5e7eb,stroke:#4b5563,color:#1f2937,stroke-width:1px

    subgraph Done ["Completed Through 18 Nov 2026 (Draft Workbook)"]
      direction TB
      S0(["1. RelaxDB Pool: 143 entries<br/>Program: 131 open vs 12 held-out"]):::program
      S_SEAL["Held-out Test Set (12 entries)<br/>Blocked by program"]:::blocked
      S1["2. Stage Local Full Text<br/>Program: 752 open DOIs from PMC XML"]:::program
      S2["3. Read Each Paper Once<br/>Reader LLM: 466 Claude + 305 Gemini"]:::reader
      S3["4. Check Quotes, Tables & Leaks<br/>Program (fixed rules): 771/771 pass<br/>Missing: sample binding & unified schema"]:::program
      S4["5. 10% Blind Spot Check<br/>Second-family LLM + curator<br/>Nov 18 (30 papers): 29/29 new values"]:::second
